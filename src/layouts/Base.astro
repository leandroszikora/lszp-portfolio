---
import "../styles/global.css";
import {
  LOCALES,
  LOCALE_CODES,
  DEFAULT_LOCALE,
  asset,
  absAsset,
  localeAbsUrl,
  type Locale,
} from "../i18n/locales";

export interface Props {
  locale: Locale;
  profile: {
    name: string;
    role: string;
    tagline: string;
    email: string;
    linkedin: string;
    github: string;
    location: string;
  };
  education: { school: string };
  siteName: string;
  title?: string;
  description?: string;
}

const { locale, profile, education, siteName } = Astro.props;
const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.tagline,
} = Astro.props;

// Every locale-aware URL is derived from the locale table, so adding a
// language never means touching this file.
const site = Astro.site;
const canonical = localeAbsUrl(locale, site);
const defaultUrl = localeAbsUrl(DEFAULT_LOCALE, site);
const alternates = LOCALE_CODES.map((code) => ({
  code,
  url: localeAbsUrl(code, site),
  ogLocale: LOCALES[code].ogLocale,
}));

const ogImage = absAsset("og-image.png", site);
const ogImageAlt = `${profile.name} — ${profile.role}`;
const ogLocale = LOCALES[locale].ogLocale;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  url: canonical,
  image: ogImage,
  email: `mailto:${profile.email}`,
  sameAs: [profile.linkedin, profile.github],
  // The site itself is published in these languages.
  knowsLanguage: [...LOCALE_CODES],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: education.school,
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: profile.location,
  },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Pre-paint theme: must run before first paint and before any
         stylesheet applies, so there is no flash of the wrong theme. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "dark" || t === "light") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (e) {}
      })();
    </script>

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />

    <!-- Language alternates: one per locale, x-default on the primary one -->
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.code} href={alt.url} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    {
      alternates
        .filter((alt) => alt.code !== locale)
        .map((alt) => (
          <meta property="og:locale:alternate" content={alt.ogLocale} />
        ))
    }
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    <slot />

    <!-- Dark-mode toggle: flips data-theme and persists the choice. -->
    <script is:inline>
      (function () {
        var btn = document.querySelector(".theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var root = document.documentElement;
          var current = root.getAttribute("data-theme");
          var isDark = current
            ? current === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches;
          var next = isDark ? "light" : "dark";
          root.setAttribute("data-theme", next);
          btn.setAttribute("aria-pressed", String(next === "dark"));
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
        });
      })();
    </script>

    <!-- Reveal-on-scroll: only touches the DOM when motion is allowed,
         so content is fully visible without JS and under reduced motion. -->
    <script is:inline>
      (function () {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (!("IntersectionObserver" in window)) return;
        var els = document.querySelectorAll("[data-reveal]");
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: "0px 0px -40px 0px" }
        );
        els.forEach(function (el) {
          el.classList.add("reveal-init");
          io.observe(el);
        });
      })();
    </script>

    <!-- Analytics: GoatCounter. Cookieless and stores no personal data, so
         no consent banner is needed. Loaded async and last; if it is blocked
         or fails, nothing else on the page is affected. It ignores localhost,
         so `npm run preview` does not pollute the stats. -->
    <script
      is:inline
      data-goatcounter="https://leandroszikora.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"></script>
  </body>
</html>
